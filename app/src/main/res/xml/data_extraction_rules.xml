<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Cloud backup keeps the Room DB + preferences; device-to-device
  transfer is allowed. Raw capture content is never device-backed-up off this device by the app
  itself; the canonical backup is the user's own Drive appData snapshot (later phase).
-->
<data-extraction-rules>
    <!-- The demo-mode flag is excluded from both: restoring a phone whose backup was taken mid-demo would
         boot straight into the sandbox, leaving the real (intact) data invisible until the user finds the
         toggle, and destroying anything entered meanwhile at the next demo re-seed. The demo database
         itself is already excluded, since only spends.db is included. -->
    <cloud-backup>
        <include domain="database" path="spends.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="spends_demo.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="spends.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="spends_demo.xml" />
    </device-transfer>
</data-extraction-rules>
